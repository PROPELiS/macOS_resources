# Git settings (useful if you're sharing the repo across systems)
.gitconfig

# YAML validation / linter outputs (if using yamllint or schema tools)
*.lint-report.yaml

# DONT INCLUDE YOUR PWs and SAVED CREDS!!!
.env
.env.*
secrets.json
config.json
